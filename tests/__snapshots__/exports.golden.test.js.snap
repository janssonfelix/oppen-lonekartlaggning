data-sort-value="37455">37&nbsp;455&nbsp;kr</td><td class="num muted" data-sort-value="">–</td><td class="num muted" data-sort-value="">–</td></tr><tr data-rad="5500|C"><td>5500 Sjuksköterska</td><td>C</td><td class="num" data-sort-value="14">14</td><td class="num jmf-block" data-sort-value="31195">31&nbsp;195&nbsp;kr</td><td class="num muted" data-sort-value="">–</td><td class="num muted" data-sort-value="">–</td><td class="num jmf-block" data-sort-value="31950">31&nbsp;950&nbsp;kr</td><td class="num muted" data-sort-value="">–</td><td class="num muted" data-sort-value="">–</td><td class="num jmf-block" data-sort-value="32455">32&nbsp;455&nbsp;kr</td><td class="num muted" data-sort-value="">–</td><td class="num muted" data-sort-value="">–</td></tr></tbody>
