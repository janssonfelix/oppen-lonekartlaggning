n.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="Tabell"/><w:tblW w:w="5000" w:type="pct"/></w:tblPr><w:tblGrid><w:gridCol w:w="1295"/><w:gridCol w:w="1295"/><w:gridCol w:w="1295"/><w:gridCol w:w="1295"/><w:gridCol w:w="1295"/><w:gridCol w:w="1295"/><w:gridCol w:w="1295"/></w:tblGrid><w:tr><w:trPr><w:cantSplit/><w:tblHeader/></w:trPr><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F0F0F0"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">BAS</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F0F0F0"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Antal</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F0F0F0"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Medelålder</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F0F0F0"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Medellön alla</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F0F0F0"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Medellön –34 år</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F0F0F0"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Medellön 35–49 år</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F0F0F0"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Medellön 50– år</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">Alla</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="prese