5">31&nbsp;195&nbsp;kr</td><td class="" data-sort-value="31975">31&nbsp;975&nbsp;kr</td><td data-sort-value="34645">34&nbsp;645&nbsp;kr</td><td data-sort-value="14">14</td><td data-sort-value="1.11">1,11</td><td class="bak-info-yta">-</td><td class="bg-info-yta halvfet ">-</td></tr><tr><td>Man <button class="btn-evidence" data-rapport-row="1" type="button" title="Visa beräkningen bakom denna rad" aria-label="Visa beräkningen för Man"><svg class="ikon ikon-sok" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></button></td><td class="" data-sort-value="33305">33&nbsp;305&nbsp;kr</td><td class="" data-sort-value="36675">36&nbsp;675&nbsp;kr</td><td data-sort-value="37455">37&nbsp;455&nbsp;kr</td><td data-sort-value="14">14</td><td data-sort-value="1.12">1,12</td><td class="bak-info-yta">-</td><td class="bg-info-yta halvfet ">-</td></tr><tr><td>2000 Ingenjör <button class="btn-evidence" data-rapport-row="1" type="button" title="Visa beräkningen bakom denna rad" aria-label="Visa beräkningen för 2000 Ingenjör"><svg class="ikon ikon-sok" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></button></td><td class="" data-sort-value="35755">35&nbsp;755&nbsp;kr</td><td class="" data-sort-value="36675">36&nbsp;675&nbsp;kr</td><td data-sort-value="37455">37&nbsp;455&nbsp;kr</td><td data-sort-value="14">14</td><td data-sort-value="1.05">1,05</td><td class="bak-info-yta" data-sort-value="36500">36&nbsp;500&nbsp;kr</td><td class="bg-info-yta halvfet fg-ok" data-sort-value="0.5">+0,5 %</td></tr><tr><td>5500 Sjuksköterska <button class="btn-evidence" data-rapport-row="1" type="butt