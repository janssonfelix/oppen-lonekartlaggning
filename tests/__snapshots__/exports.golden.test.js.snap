r><w:t xml:space="preserve">34 254 kr</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">33 807 kr</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">34 700 kr</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="1295" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">—</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:pStyle w:val="FyllIn"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">[HR fyller i]</w:t></w:r><w:r><w:t xml:space="preserve"> Bedömning: hur lönen utvecklas med åldern i organisationen, och om löneutvecklingen för äldre medarbetare avstannar.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">8. Åtgärder och tidsplan</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Dampad"/></w:pPr><w:r><w:t xml:space="preserve">Planerade lönejusteringar och andra åtgärder, med beslut, ansvar och tidsplan. Tabellen listar de grupper som ligger under referensen enligt prioriteringen, med uppskattad kostnad för att nå den.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Dampad"/></w:pPr><w:r><w:t xml:space="preserve">Inga prioriterade åtgärdsgrupper (ingen referensdata uppladdad).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="FyllIn"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">[HR fyller i]</w:t></w:r><w:r><w:t xml:space="preserve"> Besluta åtgärder, budget och tidsplan (lönejusteringar ska genomföras så snart som möjligt och senast inom tre år). Beskriv även förebyggande åtgärder.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">9. Samverkan med arbetstagarna</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="FyllIn"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">[HR fyller i]</w:t></w:r><w:r><w:t xml:space="preserve"> Dokumentera samverkan med arbetstagarorganisationerna: datum, deltagande parter och synpunkter (protokollet för gemensam lönebedömning kan bifogas).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">10. Beslut och underskrift</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="FyllIn"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">[HR fyller i]</w:t></w:r><w:r><w:t xml:space="preserve"> Beslutsfattare, datum och underskrift. Ange när nästa lönekartläggning ska genomföras (årligen).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Bilaga: Justerat lönegap i detalj</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Dampad"/></w:pPr><w:r><w:t xml:space="preserve">Skattad modell: log(lön) ~ kön + ålder + BAS-intervall (indikatorer) (OLS-regression). Lönegapet anges som en skillnad i procent: negativ när kvinnor ligger lägre.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="Tabell"/><w:tblW w:w="5000" w:type="pct"/></w:tblPr><w:tblGrid><w:gridCol w:w="4535"/><w:gridCol w:w="4535"/></w:tblGrid><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Antal observationer</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">62 (kvinnor: 31, män: 31)</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Kvinnors medianlön i procent av mäns</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">91,6 %</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Oförklarad skillnad (över 5 % och statistiskt säkerställd)</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">−10,55 % (95 % KI: −12,90 till −8,14, p &lt; 0,001, t = −8,39; HC3 robust SE)</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Ålderseffekt</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">+0,33 % per år</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">R² / justerad R²</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">70,2 % / 68,7 %</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">BAS-intervall i modellen</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">2 (B–C; indikatorvariabler, B är referens)</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:trPr><w:cantSplit/></w:trPr><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">BAS-effekter</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="4535" w:type="dxa"/></w:tcPr><w:p><w:r><w:t xml:space="preserve">nivå mot BAS B: C +10,47 % (p &lt; 0,001)</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:pStyle w:val="Heading3"/></w:pPr><w:r><w:t xml:space="preserve">Sekventiell dekomponering</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblStyle w:val="Tabell"/><w:tblW w:w="5000" w:type="pct"/></w:tblPr><w:tblGrid><w:gridCol w:w="3023"/><w:gridCol w:w="3023"/><w:gridCol w:w="3023"/></w:tblGrid><w:tr><w:trPr><w:cantSplit/><w:tblHeader/></w:trPr><w:tc><w:tcPr><w:tcW w:w="3023" w:type="dxa"/><w:shd w:val="clear" w:color="auto" w:fill="F0F0F0"/></w:tcPr><w:p><w:r><w:rPr><w:b/><